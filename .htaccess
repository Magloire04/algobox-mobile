# Configuration Apache d'AlgoBox Mobile (copiée par le workflow de déploiement).

Options -Indexes
DirectoryIndex index.html
AddDefaultCharset utf-8

# HTTPS obligatoire : un navigateur n'installe une application web qu'en HTTPS.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

AddType application/manifest+json .webmanifest
AddType text/javascript .js
AddType image/svg+xml .svg
AddCharset utf-8 .html .css .js .webmanifest .svg

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # 'unsafe-eval' : l'algorithme de l'utilisateur est traduit en JavaScript puis exécuté
  # dans son navigateur, comme dans AlgoBox (voir docs/decisions.md).
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self'; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'self'"

  # Le code de l'application est toujours revalidé, pour que les mises à jour arrivent
  # sans délai ; le service worker se charge du fonctionnement hors ligne.
  <FilesMatch "\.(html|js|css|webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(png|svg)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
